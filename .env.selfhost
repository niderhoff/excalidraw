# Self-hosted Excalidraw configuration
# Copy to .env and fill in your values

# Cloudflare R2 storage (required for production binary file storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=excalidraw-files

# Database path (SQLite file, inside the Docker volume)
DATABASE_PATH=/data/excalidraw.db

# Server port
PORT=3100

# Development only: bypass Authelia auth with a hardcoded username
# DEV_USER=dev
